generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Salon {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  timezone        String
  currency        String
  primaryDomain   String?
  customDomains   String[]
  defaultSettings Json?

  webhookSecret   String
  n8nWebhookUrl   String?

  users      User[]
  customers  Customer[]
  services   Service[]
  staff      StaffProfile[]
  settings   Setting[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id])
  email        String
  passwordHash String
  role         UserRole
  name         String
  phone        String?
  isActive     Boolean  @default(true)

  staffProfile StaffProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId, email], name: "salonId_email")
}

enum UserRole {
  SUPER_ADMIN
  SALON_ADMIN
  STAFF
}

model Customer {
  id          String   @id @default(uuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id])
  name        String
  phone       String?
  email       String?
  notes       Json?
  totalVisits Int      @default(0)
  lastVisitAt DateTime?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model Service {
  id                String   @id @default(uuid())
  salonId           String
  salon             Salon    @relation(fields: [salonId], references: [id])
  name              String
  priceCents        Int
  durationMinutes   Int
  staffRequiredCount Int    @default(1)
  addOns            Json?
  isActive          Boolean @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  skills    Json?
  photoUrl  String?
  colorTag  String?

  workingHours WorkingHours[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkingHours {
  id         String   @id @default(uuid())
  staffId    String
  staff      StaffProfile @relation(fields: [staffId], references: [id])
  dayOfWeek  Int
  startTime  String
  endTime    String
  isAvailable Boolean @default(true)
}

model Appointment {
  id              String   @id @default(uuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id])
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  staffId         String?
  staff           StaffProfile? @relation(fields: [staffId], references: [id])
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  priceCents      Int
  status          AppointmentStatus
  paymentStatus   PaymentStatus
  idempotencyKey  String?  @unique
  notes           Json?
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications NotificationLog[]

  @@index([startAt])
  @@index([staffId, startAt])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
}

model NotificationLog {
  id            String   @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  type          String
  provider      String
  payload       Json
  status        String
  sentAt        DateTime?
  createdAt     DateTime @default(now())
}

model AppointmentLock {
  id        String   @id @default(uuid())
  resource  String   @unique
  lockedBy  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  key       String
  value     Json

  @@unique([salonId, key])
}


